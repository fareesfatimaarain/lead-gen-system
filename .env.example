# ============================================================================
# Server-side infrastructure ONLY.
#
# Tenant-level provider credentials (Vapi, Anthropic, Resend, SMTP, ...) do NOT
# belong here. They live encrypted in the `credentials` table and are managed
# from the Connections page. CREDENTIAL_ENCRYPTION_KEY below is the one secret
# that must stay in the environment — it is the key those rows are sealed with.
# ============================================================================

# ---------------------------------------------------------------------------
# Postgres. Port 5455 matches docker-compose.yml (avoids clashing with a local 5432).
#
# Two connections, deliberately. The admin role owns the schema and runs DDL; the
# app role is NOSUPERUSER / NOBYPASSRLS and is the only one the running
# application uses.
#
# This is not belt-and-braces. A Postgres superuser bypasses row-level security
# **even when the table has FORCE ROW LEVEL SECURITY** — connect as one and every
# tenant policy silently stops applying, with no error anywhere. Never point
# DATABASE_URL at the admin role.
# ---------------------------------------------------------------------------
APP_DB_PASSWORD=outreach_app_dev
DATABASE_URL=postgresql://outreach_app:outreach_app_dev@localhost:5455/outreach
DATABASE_ADMIN_URL=postgresql://outreach:outreach_dev@localhost:5455/outreach

# Redis for BullMQ. Port 6399 matches docker-compose.yml.
REDIS_URL=redis://localhost:6399

# AES-256-GCM master key for the credential vault.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored credential undecryptable. Back it up.
CREDENTIAL_ENCRYPTION_KEY=

# Signs session cookies. Generate the same way as above.
SESSION_SECRET=

# Public origin, used for provider webhook callback URLs.
APP_URL=http://localhost:3000
