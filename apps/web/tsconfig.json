{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "composite": false,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@outreach/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@outreach/db": [
        "../../packages/db/src/index.ts"
      ],
      "@outreach/adapters": [
        "../../packages/adapters/src/index.ts"
      ],
      "@outreach/adapters/registry": [
        "../../packages/adapters/src/registry.ts"
      ],
      "@outreach/jobs": [
        "../../packages/jobs/src/index.ts"
      ],
      "@outreach/ingest": [
        "../../packages/ingest/src/index.ts"
      ]
    },
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
