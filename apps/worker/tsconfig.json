{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@outreach/shared": ["../../packages/shared/src/index.ts"],
      "@outreach/db": ["../../packages/db/src/index.ts"],
      "@outreach/adapters": ["../../packages/adapters/src/index.ts"],
      "@outreach/adapters/registry": ["../../packages/adapters/src/registry.ts"],
      "@outreach/jobs": ["../../packages/jobs/src/index.ts"],
      "@outreach/ingest": ["../../packages/ingest/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
