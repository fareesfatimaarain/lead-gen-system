{
  "name": "outreach-system",
  "private": true,
  "version": "0.1.0",
  "description": "Master outreach system — ICP-driven lead discovery, enrichment, research, and multi-channel outreach.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@outreach/web",
    "worker": "npm run start --workspace=@outreach/worker",
    "worker:dev": "npm run dev --workspace=@outreach/worker",
    "build": "npm run build --workspace=@outreach/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate --workspace=@outreach/db",
    "db:migrate": "npm run migrate --workspace=@outreach/db",
    "db:seed": "npm run seed --workspace=@outreach/db",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "legacy:start": "npm start --workspace=calling-agent-legacy"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
